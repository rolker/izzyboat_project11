<?xml version="1.0"?>
<package format="2">
  <name>bizzyboat_project11</name>
  <version>0.0.0</version>
  <description>
    Launch files and configuration for UNH-CCOM's Seafloor Systems EchoBoat 240 ASV (BizzyBoat).
  </description>

  <author email="roland@ccom.unh.edu">Roland Arsenault</author>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <depend>joint_state_publisher</depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>marine_nav_utilities</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>mikrotik_monitor</exec_depend>
  <exec_depend>mru_transform</exec_depend>
  <exec_depend>network_tools</exec_depend>
  <depend>ntrip_client</depend>
  <exec_depend>rmw_zenoh_cpp</exec_depend>
  <depend>robot_state_publisher</depend>
  <depend>rosbag2_transport</depend>
  <exec_depend>rtcm_msgs</exec_depend>
  <exec_depend>sbg_driver</exec_depend>
  <exec_depend>sound_speed_bridge</exec_depend>
  <exec_depend>zda_serial_bridge</exec_depend>
  <exec_depend>starlink_stats</exec_depend>
  <exec_depend>teltonika_monitor</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <depend>xacro</depend>

  <!-- Test-only: unit tests for the M3 bag-retrofit utility (#342). -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <!-- The retrofit tests write real bags with storage_id='mcap'; the plugin
       is not pulled in by rosbag2_py on minimal installs (e.g. CI). -->
  <test_depend>rosbag2_storage_mcap</test_depend>
  <test_depend>rosidl_runtime_py</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
