# Per-station settings for start_tmux_operator_project11.bash.
#
# Copy to ~/.config/project11/station.env on stations that need it. Not read
# from the repo — these describe the machine and where it sits, not BizzyBoat,
# so they must not be committed or every station would inherit one station's
# equipment. A fully equipped station has no file at all and gets the defaults.
#
#     mkdir -p ~/.config/project11
#     cp <this file> ~/.config/project11/station.env
#
# OPERATOR_LAUNCH_ARGS -- appended to operator_core_launch.py.
#
#   wifi:=false         No line-of-sight WiFi-bridge path to the boat. Drops
#                       the wifi udp_bridge connection, the mikrotik monitor,
#                       and the direct-path ping targets.
#   op_starlink:=false  No Starlink dish at this station. Drops the Starlink
#                       diagnostics node.
#   return_host_prefix:=<name>
#                       Override the station name the boat transmits back to.
#                       Defaults to this machine's short hostname; only needed
#                       if the hostname diverges from the station's DNS label.
#
# The ROC (CCOM Telepresence Room) has neither a bridge radio nor a dish:
#
#     OPERATOR_LAUNCH_ARGS="wifi:=false op_starlink:=false"
#
# OPERATOR_UI_LAUNCH_ARGS -- appended to operator_ui_launch.py, e.g.
#
#     OPERATOR_UI_LAUNCH_ARGS="sonar_rqt:=false"
