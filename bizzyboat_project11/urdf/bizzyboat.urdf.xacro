<?xml version="1.0"?>
<robot name="bizzyboat" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials -->
  <xacro:include filename="$(find bizzyboat_project11)/urdf/materials.xacro"/>

  <!-- Sensor macros -->
  <xacro:include filename="$(find bizzyboat_project11)/urdf/sensors/camera_oak.xacro"/>
  <xacro:include filename="$(find bizzyboat_project11)/urdf/sensors/gnss.xacro"/>
  <xacro:include filename="$(find bizzyboat_project11)/urdf/sensors/sonar.xacro"/>

  <!-- ========== Hull ========== -->
  <!-- base_link origin: center screw hole in hull floor, near CofG.
       Marked with L-shaped sticker showing X/Y axes.
       x = forward (bow), y = port, z = up. -->

  <link name="bizzy/base_link">
    <!-- Hull mesh (generated by scripts/generate_hull_mesh.py) -->
    <visual name="hull">
      <geometry>
        <mesh filename="package://bizzyboat_project11/meshes/hull.stl"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="hull_yellow"/>
    </visual>

    <!-- Rubber bumper/fender around hull sides -->
    <visual name="bumper_port">
      <geometry>
        <box size="1.80 0.04 0.10"/>
      </geometry>
      <origin xyz="0.0 0.47 0.15"/>
      <material name="bumper_black"/>
    </visual>
    <visual name="bumper_starboard">
      <geometry>
        <box size="1.80 0.04 0.10"/>
      </geometry>
      <origin xyz="0.0 -0.47 0.15"/>
      <material name="bumper_black"/>
    </visual>

    <!-- Mast uprights (two vertical stainless steel tubes) -->
    <visual name="mast_port">
      <geometry>
        <box size="0.04 0.04 0.95"/>
      </geometry>
      <origin xyz="0.15 0.35 0.775"/>
      <material name="metal_gray"/>
    </visual>
    <visual name="mast_starboard">
      <geometry>
        <box size="0.04 0.04 0.95"/>
      </geometry>
      <origin xyz="0.15 -0.35 0.775"/>
      <material name="metal_gray"/>
    </visual>

    <!-- Horizontal crossbar connecting mast uprights -->
    <visual name="crossbar">
      <geometry>
        <box size="0.04 0.80 0.04"/>
      </geometry>
      <origin xyz="0.15 0.0 1.15"/>
      <material name="metal_gray"/>
    </visual>
  </link>


  <!-- ========== Cameras (4x OAK-1 PoE) ========== -->
  <!-- Mounted at top of mast on 3D-printed bracket, 90deg apart.
       All tilted ~10deg downward (pitch = -0.17 rad).
       Positions are estimated [EST] — refine with measurements. -->

  <xacro:property name="cam_x" value="0.15"/>
  <xacro:property name="cam_z" value="1.25"/>
  <xacro:property name="cam_tilt" value="-0.17"/>

  <xacro:oak_camera parent="bizzy/base_link" name="oak_forward"
    x="${cam_x}" y="0" z="${cam_z}"
    pitch="${cam_tilt}" yaw="0"/>

  <xacro:oak_camera parent="bizzy/base_link" name="oak_port"
    x="${cam_x}" y="0" z="${cam_z}"
    pitch="${cam_tilt}" yaw="${pi/2}"/>

  <xacro:oak_camera parent="bizzy/base_link" name="oak_starboard"
    x="${cam_x}" y="0" z="${cam_z}"
    pitch="${cam_tilt}" yaw="${-pi/2}"/>

  <xacro:oak_camera parent="bizzy/base_link" name="oak_aft"
    x="${cam_x}" y="0" z="${cam_z}"
    pitch="${cam_tilt}" yaw="${pi}"/>


  <!-- ========== GNSS Antennas (2x CUAV C-RTK 2HP) ========== -->
  <!-- Black pucks in white brackets on crossbar ends.
       Baseline ~0.80m. Positions are estimated [EST]. -->

  <xacro:gnss_antenna parent="bizzy/base_link" name="gnss_port"
    x="0.15" y="0.40" z="1.15"/>

  <xacro:gnss_antenna parent="bizzy/base_link" name="gnss_starboard"
    x="0.15" y="-0.40" z="1.15"/>


  <!-- ========== Factory USB Camera ========== -->
  <!-- On the crossbar rail, toward the bow. -->

  <link name="bizzy/camera_usb">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.03"/>
      </geometry>
      <origin rpy="0 ${pi/2} 0" xyz="-0.01 0 0"/>
      <material name="camera_dark"/>
    </visual>
  </link>

  <joint name="base_to_camera_usb" type="fixed">
    <parent link="bizzy/base_link"/>
    <child link="bizzy/camera_usb"/>
    <origin xyz="0.55 0.0 1.15" rpy="0 0 0"/>
  </joint>

  <link name="bizzy/camera_usb_optical"/>

  <joint name="camera_usb_to_camera_usb_optical" type="fixed">
    <parent link="bizzy/camera_usb"/>
    <child link="bizzy/camera_usb_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>


  <!-- ========== Imagenex DeltaT Sonar ========== -->
  <!-- Below hull, approximate position from manual diagram.
       Exact mount position TBD. -->

  <xacro:deltat_sonar parent="bizzy/base_link" name="deltat"
    x="-0.15" y="0.0" z="-0.15"/>

</robot>
