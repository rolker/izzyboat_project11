graph izzyboat_network {
    graph [
        rankdir=LR
        fontname="Helvetica"
        fontsize=11
        pad=0.5
        splines=polyline
        nodesep=0.6
        ranksep=2.0
    ]
    node [
        fontname="Helvetica"
        fontsize=10
        shape=box
        style="filled,rounded"
        fillcolor=white
    ]
    edge [
        fontname="Helvetica"
        fontsize=9
    ]

    // ── OPERATOR SIDE ────────────────────────────────────────
    subgraph cluster_operator {
        label="Operator Network\n192.168.13.0/24"
        style="filled,rounded"
        fillcolor="#ddeeff"
        color="#336699"
        fontcolor="#336699"
        fontsize=12

        op_router [label="Operator Router\n192.168.13.1" fillcolor="#aaccee"]
        op_laptop  [label="Operator Laptop"]
        op_survey  [label="Windows PC\n(survey monitoring)"]
        op_dev     [label="Development Laptop"]

        op_router -- op_laptop
        op_router -- op_survey
        op_router -- op_dev
    }

    // ── INTERNET / CLOUD (centre) ────────────────────────────
    // NETMAP translates addresses for VPN path selection:
    //   192.168.14.x  →  192.168.12.x  (reach boat devices via VPN)
    //   192.168.15.x  →  192.168.13.x  (reach operator devices via VPN)
    internet [
        label="Internet\n\nVPN path (NETMAP):\lBoat devices:     192.168.14.x\l  maps to:        192.168.12.x\lOperator devices: 192.168.15.x\l  maps to:        192.168.13.x\l"
        shape=ellipse
        style="dashed"
        color="#999999"
        fontcolor="#666666"
        fillcolor="#f5f5f5"
        fontsize=9
    ]

    // ── BOAT SIDE ────────────────────────────────────────────
    subgraph cluster_boat {
        label="Boat Onboard Network\n192.168.12.0/24"
        style="filled,rounded"
        fillcolor="#ddeedd"
        color="#336633"
        fontcolor="#336633"
        fontsize=12

        boat_router  [label="Boat Router\n192.168.12.1"          fillcolor="#aaccaa"]
        robot_linux  [label="Robot Computer (Linux)\n192.168.12.15"]
        boat_windows [label="Windows PC\n192.168.12.8"]
        camera       [label="Camera\n192.168.12.9"]
        posmv        [label="POS MV\n192.168.12.4"]
        fcu          [label="ArduPilot FCU\n(USB serial)"
                      style="dashed,rounded" fillcolor="#f8f8f8"]

        subgraph cluster_deltat {
            label="DeltaT Subnet\n192.168.0.0/24"
            style="filled,rounded"
            fillcolor="#fff8dd"
            color="#cc8800"
            fontcolor="#cc8800"
            deltat [label="DeltaT Sonar\n192.168.0.2"]
        }

        boat_router -- robot_linux
        boat_router -- boat_windows
        boat_router -- camera
        boat_router -- posmv
        boat_router -- deltat  [style=dotted color="#cc8800"]
        robot_linux -- fcu     [label="USB" style=dashed color="#888888" fontcolor="#888888"]
    }

    // ── INTER-NETWORK LINKS ───────────────────────────────────

    // WiFi backhaul — direct, de-emphasised
    op_router -- boat_router [
        label="WiFi backhaul\n172.16.12.0/24"
        style=dashed
        color="#888888"
        fontcolor="#888888"
    ]

    // VPN path — routed through internet/cloud
    op_router -- internet [style=dotted color="#6666cc" label="VPN" fontcolor="#6666cc"]
    internet -- boat_router [style=dotted color="#6666cc" label="VPN" fontcolor="#6666cc"]
}
